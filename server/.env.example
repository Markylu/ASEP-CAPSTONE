# Copy to server/.env (gitignored) and fill in.

# Which provider answers /decide: `remote` (the LiteLLM router on the H100,
# reached over the SSH tunnel) or `local` (a vision model served on this
# laptop). Override per-invocation with `python -m server.decider --profile local`
# or `VLM_PROFILE=local ...`. The name is written into every run.json, because
# a local run's token counts are not comparable with a remote one's.
VLM_PROFILE=remote

# --- remote: the vision model on sctsvr6 ---------------------------------
# `ssh -N -L 8004:127.0.0.1:8004 sctsvr6` puts that host's vLLM container on
# this port. Deliberately not the LiteLLM router on :4000: its model_list
# routes only to the text models and has no entry for the VL container.
REMOTE_LITELLM_BASE_URL=http://127.0.0.1:8004
REMOTE_LITELLM_API_KEY=sk-local
# Served model name, as `GET /v1/models` reports it. Goes into metrics.json.
REMOTE_VLM_MODEL=Qwen3-VL-30B-A3B
REMOTE_VLM_TIMEOUT_S=120
REMOTE_VLM_MAX_TOKENS=1024

# --- local: LM Studio / llama.cpp / Ollama on this laptop ----------------
# Must be a *vision* model. `curl http://127.0.0.1:1234/v1/models` lists what
# LM Studio has loaded; just-in-time loading makes the first call slow, hence
# the longer timeout.
LOCAL_LITELLM_BASE_URL=http://127.0.0.1:1234
LOCAL_LITELLM_API_KEY=
LOCAL_VLM_MODEL=qwen/qwen3-vl-30b
LOCAL_VLM_TIMEOUT_S=300
LOCAL_VLM_MAX_TOKENS=1024

# Unprefixed vars still win over both profiles — handy for a one-off override
# such as pointing at fake_litellm.py, and how older .env files keep working.
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
# VLM_MODEL=

# 0 so a rerun of the same frame is as close to repeatable as the model allows.
# Shared by both profiles.
VLM_TEMPERATURE=0

# Defaults to <repo>/eval/runs
# RUNS_DIR=
